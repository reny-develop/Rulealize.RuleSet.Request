<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A package that distributes a document, so it carries no assembly at all. The four
    properties that make it one, and what each is for, are in the registry's
    https://github.com/reny-develop/Rulealize.Registry/blob/main/doc/publish.md

    There is nothing to compile. `IncludeBuildOutput` keeps the empty assembly this still
    produces out of the package, which is what a reader distinguishes a document package
    from a vocabulary by, and `SuppressDependenciesWhenPacking` says the truer thing about
    what a document depends on: nothing NuGet can resolve. What it draws on is in its
    `requires`, which names vocabularies and is not a package reference.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>

    <PackageId>Rulealize.RuleSet.Request</PackageId>

    <!--
      One version, in two places that have to agree: this, and the `version` the document
      declares. The fetch goes by this one and every `uses` constraint is answered by that
      one, so a release where they differ downloads perfectly and satisfies nothing.
    -->
    <Version>1.0.0</Version>

    <Authors>Reny</Authors>
    <Description>One request, raised over something and then granted or denied. A Rulealize rule set written to be held.</Description>
    <PackageTags>rulealize;ruleset;workflow;approval</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/reny-develop/Rulealize.RuleSet.Request</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="ruleset/*.json" Pack="true" PackagePath="ruleset/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
